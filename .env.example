# Copy to .env and fill in. Used by the root docker-compose.yml.

# --- Keys of external services -------------------------------------------
# DaData: geocoding of request and office addresses (required for planning).
DADATA_API_KEY=
# 2GIS MapGL key: map tiles in the browser. It is public by nature —
# restrict it to your domain in the 2GIS account.
VITE_2GIS_KEY=
# 2GIS Routing / Public Transport key for route lines on the map. Stays on the
# server (nginx adds it). Empty = use VITE_2GIS_KEY.
DGIS_ROUTING_KEY=
# 2GIS Distance Matrix key for planning with traffic; only with TRAVEL_MATRIX_PROVIDER=dgis.
DGIS_API_KEY=
# osrm (free, no traffic) or dgis. Empty = backend default (osrm).
TRAVEL_MATRIX_PROVIDER=

# --- Frontend ------------------------------------------------------------
FRONTEND_PORT=8088
# 127.0.0.1 = only this computer; 0.0.0.0 = open to the network.
FRONTEND_HOST=127.0.0.1
# false = always real API; auto = fall back to demo data when API is down.
VITE_DEMO_MODE=false

# --- Storage -------------------------------------------------------------
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
S3_BUCKET_ANSWERS=answers
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_PLANS=plans
S3_BUCKET_EXPORTS=exports
S3_EXPORT_PREFIX=exports
S3_EXPORT_RETENTION_HOURS=24
# Download links for exports point here; must be reachable from the browser.
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000

# --- Monitoring ----------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
