POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-min-8-chars
S3_BUCKET_ANSWERS=answers
S3_BUCKET_UPLOADS=uploads
S3_BUCKET_PLANS=plans
S3_BUCKET_EXPORTS=exports
S3_EXPORT_PREFIX=exports
S3_EXPORT_RETENTION_HOURS=24
S3_PUBLIC_ENDPOINT_URL=http://127.0.0.1:9000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Ключи внешних сервисов для backend в Docker; пусто — значение из config.toml.
# DaData: геокодинг адресов заявок и офиса (нужен для планирования).
DADATA_API_KEY=
# 2ГИС Distance Matrix: матрицы с пробками, только при TRAVEL_MATRIX_PROVIDER=dgis.
DGIS_API_KEY=
# osrm (бесплатно, без пробок) или dgis; пусто — значение по умолчанию (osrm).
TRAVEL_MATRIX_PROVIDER=
