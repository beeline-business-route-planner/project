APP_ENV=development
DATABASE_URL=postgresql+asyncpg://beeline:beeline@localhost:55432/beeline
BUSINESS_TIMEZONE=Europe/Moscow
GEOCODER_MODE=missing
ROUTING_PROVIDER=osrm
PLANNER_PROVIDER=deterministic
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=beeline-business-planner/1.0
NOMINATIM_EMAIL=
NOMINATIM_TIMEOUT_SECONDS=10
NOMINATIM_MIN_INTERVAL_SECONDS=1.05
DGIS_BASE_URL=https://routing.api.2gis.com
DGIS_CATALOG_BASE_URL=https://catalog.api.2gis.com
DGIS_API_KEY=
DGIS_TIMEOUT_SECONDS=15
DGIS_MATRIX_BLOCK_SIZE=25
HYBRID_DGIS_MAX_ROUTE_POINTS=5
OSRM_BASE_URL=http://localhost:5000
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_COORDINATES=80
YANDEX_API_KEY=
UPLOAD_MAX_BYTES=10485760
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=GET,POST,PATCH,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Idempotency-Key,X-Correlation-ID
CORS_EXPOSE_HEADERS=X-Correlation-ID,Content-Disposition
CORS_MAX_AGE=600
LOG_LEVEL=INFO

# Local immutable graph. Docker Compose supplies the manifest path.
# OSRM_GRAPH_MANIFEST=/absolute/path/to/graph/manifest.json
OSRM_MAX_CONCURRENCY=8
REDIS_URL=redis://localhost:56379/0
REDIS_ROUTE_TTL_SECONDS=21600
REDIS_TIMEOUT_SECONDS=0.25
ROUTE_OVERVIEW_TOLERANCE_METERS=20
# Run scripts/prepare_osrm.py and set OSRM_DATA_DIR to its output directory.
