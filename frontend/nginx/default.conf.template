# Single entry point: the SPA, the backend API and the 2GIS routing proxy share
# one origin, so the browser never sees the backend host or the routing key.
# ${BACKEND_URL} and ${DGIS_ROUTING_KEY} are filled in by envsubst on start.

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 20m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A stopped backend container has no IP: fail fast instead of the 60 s default.
        proxy_connect_timeout 5s;
        # Planning a district can take a while.
        proxy_read_timeout 300s;
    }

    # /dgis-routing/<path> -> https://routing.api.2gis.com/<path>?key=...
    location /dgis-routing/ {
        rewrite ^/dgis-routing/(.*)$ /$1?key=${DGIS_ROUTING_KEY} break;
        proxy_pass https://routing.api.2gis.com;
        proxy_ssl_server_name on;
        proxy_set_header Host routing.api.2gis.com;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_read_timeout 60s;
    }

    # Hashed build assets never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: every other path is the app itself.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
