VITE_API_BASE_URL=http://localhost:8000/api
# auto: использовать API, при недоступности включить демонстрационные данные
# true: всегда использовать демонстрационные данные
# false: требовать доступный API и показывать ошибку без fallback
VITE_DEMO_MODE=auto
# Ключ MapGL JS API из кабинета 2ГИС. Секретное значение храните только в .env.
VITE_2GIS_KEY=
