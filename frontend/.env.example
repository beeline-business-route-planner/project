VITE_API_BASE_URL=/api
# auto: показывать демо и предупреждение, если API недоступен
# true: принудительный демонстрационный режим
# false: строго требовать API
VITE_DEMO_MODE=auto
# Публичный браузерный ключ 2ГИС для карты; ограничьте его по домену в кабинете 2ГИС.
VITE_2GIS_KEY=
# Ключ 2ГИС Routing / Public Transport для линий маршрутов. Без префикса VITE_,
# поэтому остаётся в dev-сервере и не попадает в бандл; пусто — используется VITE_2GIS_KEY.
DGIS_ROUTING_KEY=
